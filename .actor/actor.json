{
  "actorSpecification": 1,
  "name": "page-to-markdown",
  "title": "Web Page to Markdown & Article Extractor for LLMs and RAG",
  "description": "Convert a list of URLs into clean Markdown for LLMs and RAG: main article text only (no nav, ads or cookie banners), title, author, date, word and token counts, and optional chunks. HTML to Markdown and article extraction at $1 per 1,000 pages.",
  "version": "1.0",
  "buildTag": "latest",
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "dockerfile": "../Dockerfile",
  "readme": "../README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Pages",
          "transformation": {
            "fields": [
              "url",
              "title",
              "wordCount",
              "estimatedTokens",
              "extractionMode",
              "markdown",
              "error"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "url": {
                "label": "URL",
                "format": "link"
              },
              "title": {
                "label": "Title"
              },
              "wordCount": {
                "label": "Words",
                "format": "number"
              },
              "estimatedTokens": {
                "label": "~Tokens",
                "format": "number"
              },
              "extractionMode": {
                "label": "Mode"
              },
              "markdown": {
                "label": "Markdown"
              },
              "error": {
                "label": "Error"
              }
            }
          }
        }
      }
    }
  }
}
